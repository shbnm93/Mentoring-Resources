-- data aggregation
-- basic group by syntax
-- count the rows for each category name
select
  category_name,
  count(*) as record_count
from `wisdom_pets.products`
group by category_name
order by category_name;


-- multiple group by caluclations
select
  category_name,
  count(*) as record_count,
  avg(retail_price) as average_retail_price,
  max(rating) as max_rating
from `wisdom_pets.products`
group by category_name
order by category_name;


-- having clause
select
  category_name,
  count(*) as record_count,
  avg(retail_price) as average_retail_price,
  max(rating) as max_rating
from `wisdom_pets.products`
group by category_name
having average_retail_price < 10
order by category_name;



-- A very common mistake is to try to use a WHERE clause to perform the same operation.
select
  category_name,
  count(*) as record_count,
  avg(retail_price) as average_retail_price,
  max(rating) as max_rating
from `wisdom_pets.products`
where average_retail_price < 10
group by category_name
order by category_name;
-- Because the WHERE is executed prior to the GROUP BY, the BigQuery engine will not have any clue what the calculated average retail price is. 
-- The HAVING clause, however, is used specifically to filter records from the GROUP BY output. 
-- But what if we wanted to perform a GROUP BY operation with the WHERE clause to pre-filter our data before they are used in any aggregate calculations? We can definitely do this.
-- The WHERE clause goes straight after the from and the GROUP BY goes after the WHERE. This actually follows the SQL Order of Operations.
select
  category_name,
  count(*) as record_count
from `wisdom_pets.products`
where retail_price < 10
group by category_name
order by category_name;



-- multiple-column group by
select
  category_name,
  wholesale_discount_percentage,
  count(*) as record_count
from `wisdom_pets.products`
group by 
  category_name,
  wholesale_discount_percentage
order by 
